#!/bin/sh
#
# git-branch-picker - interactive git branch list for POSIX shells
#
#   Up / Down (or k / j)    move the selection
#   Enter                   check out the selected branch
#   Delete / Backspace      delete the selected branch (y/n confirmation)
#   Escape / Ctrl-C (or q)  quit
#
# Requires only: sh, git, stty, dd, od, awk, tr.  No bash, no arrays.

set -u

PROG=${0##*/}
IN_ALT=0        # 1 while the alternate screen buffer is in use
TTY_STATE=''
BRANCHES=''     # newline separated list
COUNT=0
CURRENT=''
SEL=1           # 1-based index of the highlighted branch
OFF=0           # number of branches scrolled off the top
MSG=''          # transient status line
REPO=''         # repository name, shown in the header
ROWS=24
COLS=80

die() {
	printf '%s: %s\n' "$PROG" "$*" >&2
	exit 1
}

# ---------------------------------------------------------------- terminal --

open_tty() {
	[ -r /dev/tty ] && [ -w /dev/tty ] || die 'no controlling terminal'
	exec 3</dev/tty 4>/dev/tty
	TTY_STATE=$(stty -g <&3 2>/dev/null) || die 'cannot read terminal settings'
}

raw_mode() {
	stty raw -echo <&3
	printf '\033[?1049h\033[?25l' >&4   # alternate screen, hide cursor
	IN_ALT=1
}

cooked_mode() {
	[ "$IN_ALT" = 1 ] || return 0
	IN_ALT=0
	printf '\033[?25h\033[?1049l' >&4   # show cursor, leave alternate screen
	[ -n "$TTY_STATE" ] && stty "$TTY_STATE" <&3 2>/dev/null
	return 0
}

trap 'cooked_mode; exit 130' INT HUP TERM
trap 'cooked_mode' EXIT

term_size() {
	size=$(stty size <&3 2>/dev/null) || size=''
	ROWS=${size%% *}
	COLS=${size##* }
	case $ROWS in ''|*[!0-9]*) ROWS=0 ;; esac
	case $COLS in ''|*[!0-9]*) COLS=0 ;; esac
	[ "$ROWS" -lt 3 ] && ROWS=24
	[ "$COLS" -lt 20 ] && COLS=80
	return 0
}

# --------------------------------------------------------------- key input --

# Read exactly one byte from the terminal, echo it back as a decimal number
# (empty when nothing arrived before the read timed out).
getbyte() {
	dd bs=1 count=1 2>/dev/null <&3 | od -An -tu1 | tr -dc '0-9'
}

# Sets KEY to one of: UP DOWN ENTER DEL ESC QUIT HOME END OTHER
read_key() {
	KEY=OTHER
	b=$(getbyte)
	case $b in
		'')  KEY=OTHER ;;
		27)  read_escape ;;
		10|13)   KEY=ENTER ;;
		8|127)   KEY=DEL ;;
		3|4)     KEY=INTR ;;      # Ctrl-C, Ctrl-D
		100)     KEY=DEL ;;       # d
		106|14)  KEY=DOWN ;;      # j, Ctrl-N
		107|16)  KEY=UP ;;        # k, Ctrl-P
		113)     KEY=QUIT ;;      # q
		*)       KEY=OTHER ;;
	esac
}

# Escape was received: decide between a bare Escape and a cursor sequence.
read_escape() {
	stty min 0 time 1 <&3          # 0.1s grace for the rest of the sequence
	b2=$(getbyte)
	b3=''
	[ -n "$b2" ] && b3=$(getbyte)
	case "$b2:$b3" in
		':')            KEY=ESC ;;
		91:65|79:65)    KEY=UP ;;     # ESC [ A , ESC O A
		91:66|79:66)    KEY=DOWN ;;   # ESC [ B , ESC O B
		91:72|79:72)    KEY=HOME ;;
		91:70|79:70)    KEY=END ;;
		91:51)          drain; KEY=DEL ;;   # ESC [ 3 ~  (Delete)
		*)              drain; KEY=OTHER ;;
	esac
	stty min 1 time 0 <&3
	return 0
}

drain() {
	while :; do
		x=$(getbyte)
		[ -z "$x" ] && break
	done
}

# Blocking y/n question drawn on the last line.  Sets ANS to y or n.
confirm() {
	printf '\033[%d;1H\033[K\033[7m %s [y/N] \033[0m' "$ROWS" "$1" >&4
	ANS=n
	while :; do
		b=$(getbyte)
		case $b in
			121|89) ANS=y; return 0 ;;                 # y / Y
			27)                                        # Esc, or an escape sequence
				stty min 0 time 1 <&3
				drain
				stty min 1 time 0 <&3
				ANS=n
				return 0
				;;
			110|78|3|13|10) ANS=n; return 0 ;;         # n / N / Ctrl-C / Enter
			*) ;;
		esac
	done
}

# ------------------------------------------------------------------- model --

load_branches() {
	BRANCHES=$(git for-each-ref --format='%(refname:short)' --sort=-committerdate refs/heads/)
	CURRENT=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || CURRENT=''
	if [ -z "$BRANCHES" ]; then
		COUNT=0
	else
		COUNT=$(printf '%s\n' "$BRANCHES" | wc -l | tr -dc '0-9')
	fi
	[ "$SEL" -gt "$COUNT" ] && SEL=$COUNT
	[ "$SEL" -lt 1 ] && SEL=1
	return 0
}

branch_at() {
	printf '%s\n' "$BRANCHES" | sed -n "$1p"
}

# ------------------------------------------------------------------- view ---

draw() {
	term_size
	body=$((ROWS - 4))
	[ "$body" -lt 1 ] && body=1

	[ "$SEL" -lt $((OFF + 1)) ] && OFF=$((SEL - 1))
	[ "$SEL" -gt $((OFF + body)) ] && OFF=$((SEL - body))
	[ "$OFF" -lt 0 ] && OFF=0

	list=''
	if [ "$COUNT" -gt 0 ]; then
		list=$(printf '%s\n' "$BRANCHES" | awk \
			-v sel="$SEL" -v off="$OFF" -v vis="$body" \
			-v cur="$CURRENT" -v w="$COLS" '
			NR > off && NR <= off + vis {
				name = $0
				line = (name == cur ? "* " : "  ") name
				if (length(line) > w) line = substr(line, 1, w)
				if (NR == sel) {
					pad = w - length(line)
					s = ""
					while (pad-- > 0) s = s " "
					printf "\033[7m%s%s\033[0m\r\n", line, s
				} else if (name == cur) {
					printf "\033[32m%s\033[0m\r\n", line
				} else {
					printf "%s\r\n", line
				}
			}')
	fi

	{
		printf '\033[H\033[2J'
		printf '\033[1m %s\033[0m' "$REPO"
		printf '  \033[2m%s branch(es), on %s\033[0m\r\n\r\n' \
			"$COUNT" "${CURRENT:-detached HEAD}"
		if [ "$COUNT" -eq 0 ]; then
			printf '  \033[2mno local branches\033[0m\r\n'
		else
			printf '%s\r\n' "$list"
		fi
		printf '\033[%d;1H\033[2m%s\033[0m' "$((ROWS - 1))" \
			' up/down move   enter checkout   del/bksp delete   esc quit'
		printf '\033[%d;1H\033[K%s' "$ROWS" "$MSG"
	} >&4
	MSG=''
	return 0
}

# One-line status message, safely flattened for raw mode.
say() {
	MSG=$(printf '%s' "$1" | tr '\n\r\t' '   ' | cut -c "1-$COLS")
}

# ----------------------------------------------------------------- actions --

do_checkout() {
	branch=$(branch_at "$SEL")
	[ -n "$branch" ] || return 0
	if [ "$branch" = "$CURRENT" ]; then
		say "already on '$branch'"
		return 0
	fi
	cooked_mode
	git checkout "$branch"
	exit $?
}

do_delete() {
	branch=$(branch_at "$SEL")
	[ -n "$branch" ] || return 0
	if [ "$branch" = "$CURRENT" ]; then
		say "cannot delete '$branch': it is the current branch"
		return 0
	fi

	confirm "Delete branch '$branch'?"
	[ "$ANS" = y ] || { say 'cancelled'; return 0; }

	if out=$(git branch -d "$branch" 2>&1); then
		say "deleted '$branch'"
	else
		case $out in
			*"not fully merged"*)
				confirm "'$branch' is not fully merged. Force delete?"
				if [ "$ANS" = y ]; then
					if out=$(git branch -D "$branch" 2>&1); then
						say "force deleted '$branch'"
					else
						say "$out"
					fi
				else
					say 'cancelled'
				fi
				;;
			*) say "$out" ;;
		esac
	fi

	load_branches
	[ "$SEL" -gt "$COUNT" ] && SEL=$COUNT
	[ "$SEL" -lt 1 ] && SEL=1
	return 0
}

# ------------------------------------------------------------------- main ---

case ${1:-} in
	-h|--help)
		sed -n '2,10s/^# \{0,1\}//p' "$0"
		exit 0
		;;
esac

git rev-parse --git-dir >/dev/null 2>&1 || die 'not inside a git repository'

REPO=$(git rev-parse --show-toplevel 2>/dev/null)
REPO=${REPO##*/}
[ -n "$REPO" ] || REPO='git'

open_tty
load_branches
raw_mode

while :; do
	draw
	read_key
	case $KEY in
		UP)     [ "$SEL" -gt 1 ] && SEL=$((SEL - 1)) ;;
		DOWN)   [ "$SEL" -lt "$COUNT" ] && SEL=$((SEL + 1)) ;;
		HOME)   SEL=1 ;;
		END)    SEL=$COUNT ;;
		ENTER)  [ "$COUNT" -gt 0 ] && do_checkout ;;
		DEL)    [ "$COUNT" -gt 0 ] && do_delete ;;
		ESC|QUIT)
			cooked_mode
			exit 0
			;;
		INTR)
			cooked_mode
			exit 130
			;;
	esac
done
